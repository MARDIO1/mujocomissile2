<?xml version="1.0" encoding="utf-8"?>
<mujoco model="cart_system">
    <option timestep="0.002" integrator="RK4" gravity="0 0 -9.81">
    <!-- 上帝设置 -->
    </option>
    <!-- 视觉渲染设置 -->
    <visual>
        <headlight diffuse="0.6 0.7 0.7"/>
        <rgba>0.95 0.95 0.95 1</rgba>
    </visual>

    <!-- 材质定义 -->
    <asset>
        <material name="ground_material" rgba="0.8 0.6 0.4 1" shininess="1"/>
        <material name="cart_material" rgba="0.3 0.3 0.9 0.5" shininess="0.5"/>
        <material name="collision_material" rgba="1.0 0.28 0.1 0.6" shininess="0.5" />
        <material name="no_see" rgba="0 0 0 0" shininess="0"/>
    </asset>

    <!-- 模型统计信息 -->
    <statistic center="0 0 0" extent="2"/>

    <!--一些类-->
    <default>
        <default class="robot">
            <default class="visual">
            <geom material="collision_material" contype="0" conaffinity="0" group="2" />
            </default>

            <default class="collision">
            <geom material="collision_material" condim="3" contype="1" conaffinity="1" priority="1" group="1" solref="0.005 1" solimp="0.99 0.999 1e-05" friction="1 0.01 0.01" />
            </default>
        </default>
    </default>
</mujoco>