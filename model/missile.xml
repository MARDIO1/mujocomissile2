<mujoco model="missile_model">
<!-- 模型统计信息 -->
    <statistic center="0 0 0" extent="2"/>
    <!-- 材质 -->
    <asset>
    <mesh name="m2_link.STL" file="m2.SLDASM/meshes/m2_link.STL" />
    </asset>
    <!-- 物理世界 -->
    <worldbody>        
        <!-- 飞镖主体 斜向上30度-->
        <body name="missile" pos="0 0 0.4" quat="0.9659258262890683 0 -0.25881904510252074 0">
            <!-- 飞镖主关节 - 真正重要的true important -->
            <joint name="missile_main_joint" type="free"/>
            <!--IMU site-->
            <site name="IMU_site" pos="0 0 0" size="0.01" rgba="0 1 0 1"/>
            
            
            <!--飞镖力学参数 质量，惯量，-->
            <inertial pos="0.0 0.0 0.0" mass="0.13864" 
                      fullinertia="0.00099140729 0.00094740113 0.00016727527 0.0 0.0 0.0"/>
            
            <!--仿真用来看的 摄像头 -->
            <camera name="missile_cam" pos="0.1 0.0 0" quat="-0.5 -0.5 0.5 0.5" fovy="160" />
            <site name="camera_site" pos="0.1 0.0 0.0" quat="1 0 0 0" type="sphere"  size="0.005" rgba="1 0 0 1"/>
            
            <!-- 飞镖主体几何体 - STL模型 转个90度 有且只有这个有碰撞体积。also important -->
            <geom name="m2_link_collision" pos="-0.00898 +0.01 +0.01690" quat="0.7071067811865476 0.0 0.0 -0.7071067811865476" type="mesh" mesh="m2_link.STL" class="collision"/>
            <geom name="m2_link_visual" pos="-0.00898 +0.01 +0.01690" quat="0.7071067811865476 0.0 0.0 -0.7071067811865476" material="" type="mesh" mesh="m2_link.STL" class="visual" />
        
            <!-- 飞镖  标记方向方块 -->
            <geom name="missile_visual_1" pos="0 0 0" type="box" size="0.2 0.005 0.005" material="cart_material" class="visual"/>
            <geom name="missile_visual_2" pos="0 0 0" type="box" size="0.005 0.2 0.005" material="cart_material" class="visual"/>
            <geom name="missile_visual_3" pos="0 0 0" type="box" size="0.005 0.005 0.2" material="cart_material" class="visual"/>
            
        </body>
    </worldbody>

    <sensor>
        <accelerometer site="IMU_site"/>
        <gyro          site="IMU_site"/>
    </sensor>

</mujoco>
